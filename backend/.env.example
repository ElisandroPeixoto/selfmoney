# Environment: development | production
APP_ENV=development

# Development uses a local SQLite file.
DATABASE_URL=sqlite:///./selfmoney.db

# Production (Supabase): copy the connection string from
# Project Settings > Database > Connection string (URI) and install the
# postgres extra (`pip install -e ".[postgres]"`). Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Create tables automatically on startup (handy in dev; use Alembic in prod).
AUTO_CREATE_TABLES=true

# Password to open the app. Empty = no login (development only).
# With APP_ENV=production the API refuses to start unless both are set.
APP_PASSWORD=
# Long random value that signs login sessions (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))").
SECRET_KEY=
